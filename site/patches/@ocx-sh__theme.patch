diff --git a/src/components/terminal.mjs b/src/components/terminal.mjs
index 4992767f54e1daf9ec03cee9954ec761adf5d15a..73293cb277b61b5732faf75855f074773595f800 100644
--- a/src/components/terminal.mjs
+++ b/src/components/terminal.mjs
@@ -252,7 +252,14 @@ export function mountTerminal(root, loadPlayer = loadDefault) {
   const opts = /** @type {PlayerOptions} */ (parsed);
   // Prefetch on mount, collapsed or not, so expanding is instant (ocx 2210983da).
   // Low priority: many casts on one page must not compete with the main content.
-  const data = fetch(root.dataset['src'] ?? '', { priority: 'low' }).then((r) => {
+  // Starts a second after the window load event: a request issued while the page paints joins the critical
+  // path of the first paint in Lighthouse's simulation (largest-contentful-paint 1.8 s instead of 1.7 s).
+  const loaded = new Promise((done) => {
+    const later = () => setTimeout(done, 1000);
+    if (document.readyState === 'complete') later();
+    else addEventListener('load', later, { once: true });
+  });
+  const data = loaded.then(() => fetch(root.dataset['src'] ?? '', { priority: 'low' })).then((r) => {
     if (!r.ok) throw new Error(`HTTP ${r.status}`);
     return r.text();
   });
