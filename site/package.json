{
  "name": "find-ocx-site",
  "private": true,
  "type": "module",
  "scripts": {
    "port": "node scripts/port-docs.mjs",
    "dev": "pnpm run port && astro dev --host",
    "build": "pnpm run port && astro build",
    "test": "node --test scripts/port-docs.test.mjs scripts/stubs.test.mjs scripts/lighthouse.test.mjs scripts/record-casts.test.mjs",
    "check": "node scripts/check-anchors.mjs && ocx-site check --dist dist",
    "lighthouse": "node scripts/lighthouse.mjs"
  },
  "dependencies": {
    "@astrojs/starlight": "0.42.4",
    "@ocx-sh/theme": "0.1.1",
    "astro": "7.3.5"
  },
  "devDependencies": {
    "@lhci/cli": "0.15.1",
    "chrome-launcher": "1.2.1",
    "lighthouse": "12.6.1",
    "playwright-core": "^1.63.0"
  }
}
